{
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/player", "destination": "/api/player" }
  ],
  "crons": [
    { "path": "/api/refresh", "schedule": "*/5 * * * *" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "docs/index.html"
    },
    "api/player.js": {
      "includeFiles": "docs/player.html"
    },
    "api/stream.js": {
      "maxDuration": 30
    },
    "api/proxy.js": {
      "maxDuration": 60
    }
  }
}
