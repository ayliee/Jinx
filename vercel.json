{
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/player", "destination": "/api/player" },
    { "source": "/api/anime/:slug", "destination": "/api/anime.info?slug=:slug" },
    { "source": "/api/episodes/:slug", "destination": "/api/episode.list?slug=:slug" },
    { "source": "/api/browse/:category/:value", "destination": "/api/browse.list?category=:category&value=:value" }
  ],
  "crons": [
    { "path": "/api/refresh", "schedule": "0 0 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "docs/index.html"
    },
    "api/player.js": {
      "includeFiles": "docs/player.html"
    },
    "api/stream.js": {
      "maxDuration": 30
    },
    "api/proxy.js": {
      "maxDuration": 60
    }
  }
}
